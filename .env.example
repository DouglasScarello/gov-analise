# Configurações de API para o Câmara Analytics (V4.0)

# Chave da API do Google Gemini (Opcional, para resumos avançados e sentimento)
# Obtenha em: https://aistudio.google.com/
GOOGLE_API_KEY=

# Chave da API da OpenAI (Alternativa para GPT-4o-mini)
OPENAI_API_KEY=

# Chave pública da API do CNJ DataJud (processos judiciais)
# Obtenha em: https://datajud-wiki.cnj.jus.br/
DATAJUD_API_KEY=

# Chave da API do Portal da Transparência (CGU)
# Obtenha em: https://portaldatransparencia.gov.br/api-de-dados
PORTAL_TRANSPARENCIA_API_KEY=

# Domínio(s) do frontend com permissão de CORS na API, separados por vírgula.
# Sem essa variável, a API só aceita localhost:3000 (dev). Defina em produção,
# ex: CORS_ALLOWED_ORIGINS=https://govanalise.com.br
CORS_ALLOWED_ORIGINS=

# Token da API pública da Câmara Municipal de Florianópolis (fallback do municipal_tracker)
TOKEN_CMF=
