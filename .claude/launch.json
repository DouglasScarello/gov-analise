{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "parlamentar_dashboard",
      "runtimeExecutable": "poetry",
      "runtimeArgs": ["run", "streamlit", "run", "modules/parlamentar_dashboard/app.py", "--server.headless", "true"],
      "port": 8501
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "poetry",
      "runtimeArgs": ["run", "uvicorn", "api.main:app", "--reload", "--port", "8000"],
      "port": 8000
    }
  ]
}
